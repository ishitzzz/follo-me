{
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_title": "Lyto AI"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "description": "Open Lyto side panel",
         "suggested_key": {
            "default": "Ctrl+Shift+L",
            "mac": "MacCtrl+Shift+L"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js" ],
      "match_about_blank": true,
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: https: blob: http://localhost:3000"
   },
   "description": "AI-powered research assistant and browser control.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Lyto AI - Research Assistant",
   "permissions": [ "activeTab", "tabs", "scripting", "storage", "webNavigation", "sidePanel", "debugger", "clipboardWrite", "tabGroups", "cookies", "contextMenus", "notifications", "downloads" ],
   "side_panel": {
      "default_path": "panel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.1.5",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "panel.html", "preview.html", "assets/*", "katex.min.js", "katex.min.css", "fonts/*" ]
   } ]
}
